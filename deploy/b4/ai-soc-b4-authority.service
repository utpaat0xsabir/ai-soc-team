[Unit]
Description=B4 independent authority
Requires=ai-soc-b4-authority.socket
After=ai-soc-b4-authority.socket

[Service]
Type=exec
User=ai-soc-b4-authority
Group=ai-soc-b4-authority
ExecStart=/opt/ai-soc-b4-authority/venv/bin/python -IB /opt/ai-soc-b4-authority/scripts/b4_authority.py
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=default
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/var/lib/ai-soc-b4-authority
TasksMax=8
MemoryMax=256M
CPUQuota=50%
LimitNOFILE=64
LimitCORE=0
Restart=on-failure
RestartSec=2s
